# Platform env for windows-arm64.
# Sourced by scripts/env.sh after .common.env.
# The versioner bundle has no windows-arm64 build (upstream ships
# windows-amd64 only); env.sh falls back to versioner on PATH.
# The logamuffin bundle does ship windows-arm64 (tools/logamuffin/v*/
# windows-arm64/logamuffin.exe; fallback: logamuffin on PATH).

PROJECT_PLATFORM="windows-arm64"
VERSIONER_BIN_NAME="versioner.exe"
LOGAMUFFIN_BIN_NAME="logamuffin.exe"
# RUNNER_SPAWNER_BIN is resolved by env.sh to the newest
# tools/runner-spawner/v*/windows-arm64/runner-spawner.exe (fallback: runner-spawner on PATH).
RUNNER_SPAWNER_BIN_NAME="runner-spawner.exe"
