# Platform env for macos-x86_64.
# Sourced by scripts/env.sh after .common.env.
# VERSIONER_BIN is resolved by env.sh to the newest
# tools/versioner/v*/macos-x86_64/versioner (fallback: versioner on PATH).
# LOGAMUFFIN_BIN is resolved by env.sh to the newest
# tools/logamuffin/v*/macos-x86_64/logamuffin (fallback: logamuffin on PATH).

PROJECT_PLATFORM="macos-x86_64"
VERSIONER_BIN_NAME="versioner"
LOGAMUFFIN_BIN_NAME="logamuffin"
# RUNNER_SPAWNER_BIN is resolved by env.sh to the newest
# tools/runner-spawner/v*/macos-x86_64/runner-spawner (fallback: runner-spawner on PATH).
RUNNER_SPAWNER_BIN_NAME="runner-spawner"
